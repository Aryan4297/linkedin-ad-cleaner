{
  "manifest_version": 3,
  "name": "LinkedIn Ad Cleaner",
  "version": "1.0.0",
  "description": "Hides sponsored and promoted content on LinkedIn.",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
